/*
  Cloud Firestore Security Rules（雲端文件資料庫安全規則）草稿

  重要狀態：
  1. 本檔是版本控制中的規則來源；每次修改後必須先測試，再由管理員部署。
  2. 系統已使用 Firebase Authentication（Firebase 身分驗證）與 Google（Google 帳號）登入。
  3. 保留第一位管理員以 UID（使用者識別碼）建立的 userAccess（使用者存取權限）文件作為安全退路。
  4. manager（課長）、clerk（文員）、productionDevelopment（開發）、productionControl（生管）與 sales（業務）
     都必須建立 rolePermissions（角色功能權限）文件後才能登入。
  5. admin（管理員）保留固定完整管理能力；其他角色依 rolePermissions（角色功能權限）開放。

  規則技術字串：
  - rules_version（規則版本）
  - service（服務）
  - match（資料路徑比對）
  - allow（允許條件）
  - read（讀取）、get（讀取單筆）、list（讀取清單）
  - create（新增）、update（修改）、delete（刪除）、write（寫入）
  - request.auth（可信任登入身分）
  - request.resource（寫入後資料）
  - resource（寫入前資料）
  - database（資料庫識別）
*/

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // signedIn（已登入判斷）
    function signedIn() {
      return request.auth != null;
    }

    // verifiedGoogleAccount（已驗證 Google 帳號判斷）
    function verifiedGoogleAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.size() > 3
        && request.auth.token.email.size() <= 254;
    }

    // hasUidAccessDocument（具有 UID 使用者權限文件）
    function hasUidAccessDocument() {
      return verifiedGoogleAccount()
        && exists(/databases/$(database)/documents/userAccess/$(request.auth.uid));
    }

    // accessDocument（目前使用者的 UID 權限文件）
    function accessDocument() {
      return get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data;
    }

    // activeAccount（帳號已啟用）
    function activeAccount() {
      return hasUidAccessDocument() && accessDocument().active == true;
    }

    // admin（管理員）、manager（課長）、clerk（文員）、productionDevelopment（開發）、productionControl（生管）、sales（業務）
    // isAdmin（管理員判斷）
    function isAdmin() {
      return activeAccount() && accessDocument().role == 'admin';
    }

    // isConfigurableRole（可設定權限角色判斷）
    function isConfigurableRole() {
      return activeAccount()
        && accessDocument().role in [
          'manager', 'clerk', 'productionDevelopment', 'productionControl', 'sales'
        ];
    }

    // isDeskUser（允許使用桌機系統的角色判斷）
    function isDeskUser() {
      return isAdmin() || isConfigurableRole();
    }

    // featureParentEnabled（主功能已開啟）：舊文件尚無主功能欄位時維持既有權限。
    function featureParentEnabled(features, feature) {
      return (!(feature in ['summary', 'costView'])
          || !('productsMain' in features)
          || features.productsMain == true)
        && (!(feature in ['settings', 'costlog', 'export'])
          || !('costMain' in features)
          || features.costMain == true)
        && (feature != 'export'
          || ('costMain' in features)
          || features.costView == true)
        && (feature != 'orderImport' || features.progress == true)
        && (feature != 'costView' || features.summary == true);
    }

    // configuredRoleHasFeature（可設定角色具有功能權限）
    function configuredRoleHasFeature(feature) {
      let roleId = accessDocument().role;
      let rolePath = /databases/$(database)/documents/rolePermissions/$(roleId);
      return exists(rolePath)
        && get(rolePath).data.active == true
        && get(rolePath).data.role == roleId
        && get(rolePath).data.features[feature] == true
        && featureParentEnabled(get(rolePath).data.features, feature);
    }

    // hasFeature（具有功能權限）
    function hasFeature(feature) {
      return isAdmin() || (isConfigurableRole() && configuredRoleHasFeature(feature));
    }

    // validShortString（短文字安全檢查）
    function validShortString(value, maximumLength) {
      return value is string && value.size() > 0 && value.size() <= maximumLength;
    }

    // 功能識別：progress（訂單資料）、sync（工序秒數同步）
    // accounts（帳號管理）、export（匯出）、costView（查看工價）、settings（成本設定）、costlog（成本記錄）
    // productsMain（款號管理主功能）、summary（款號總表）、orderImport（訂單匯入）、cutting（裁帶統計）
    // costMain（成本管理主功能）
    // validFeatureMap（功能權限欄位檢查）
    function validFeatureMap(features) {
      return features is map
        && features.keys().hasAll([
          'progress', 'accounts', 'export', 'costView', 'costlog', 'productsMain',
          'summary', 'orderImport', 'cutting', 'sync', 'costMain'
        ])
        && features.keys().hasOnly([
          'progress', 'accounts', 'export', 'costView', 'costlog', 'productsMain',
          'summary', 'orderImport', 'cutting', 'sync', 'costMain', 'settings'
        ])
        && features.progress is bool
        && features.accounts is bool
        && features.export is bool
        && features.costView is bool
        && features.costlog is bool
        && features.productsMain is bool
        && features.summary is bool
        && features.orderImport is bool
        && features.cutting is bool
        && features.sync is bool
        && features.costMain is bool
        && (!('settings' in features) || features.settings is bool)
        && features.accounts == false;
    }

    // validUserAccess（使用者存取權限資料檢查）
    function validUserAccess(userId) {
      return request.resource.data.keys().hasAll([
          'username', 'role', 'active', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'username', 'displayName', 'department', 'role', 'active', 'updatedAt', 'updatedBy',
          'email', 'authUid', 'googleDisplayName', 'createdAt', 'lastLoginAt'
        ])
        && validShortString(request.resource.data.username, 100)
        && request.resource.data.role in [
          'admin', 'manager', 'clerk', 'productionDevelopment', 'productionControl', 'sales'
        ]
        && request.resource.data.active is bool
        && request.resource.data.updatedAt is int
        && validShortString(request.resource.data.updatedBy, 100)
        && (!('displayName' in request.resource.data)
          || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() <= 200))
        && (!('department' in request.resource.data)
          || (request.resource.data.department is string
            && request.resource.data.department.size() <= 100))
        && (
          !('email' in request.resource.data)
          || (
            request.resource.data.keys().hasAll([
              'email', 'authUid', 'googleDisplayName', 'createdAt'
            ])
            && validShortString(request.resource.data.email, 254)
            && request.resource.data.email.matches('^[^/]+@[^/]+$')
            && request.resource.data.authUid is string
            && request.resource.data.authUid.size() <= 128
            && request.resource.data.authUid.matches('^[^/]*$')
            && (request.resource.data.email == userId
              || (request.resource.data.authUid == userId
                && request.resource.data.authUid.size() > 0))
            && request.resource.data.googleDisplayName is string
            && request.resource.data.googleDisplayName.size() <= 200
            && request.resource.data.createdAt is int
            && (!('lastLoginAt' in request.resource.data)
              || request.resource.data.lastLoginAt is int)
          )
        );
    }

    // selfCreatesUidAccess（本人首次登入時由電子信箱核准資料建立 UID 權限文件）
    function selfCreatesUidAccess(userId) {
      let emailPath = /databases/$(database)/documents/userAccess/$(request.auth.token.email);
      let invitation = get(emailPath).data;
      return verifiedGoogleAccount()
        && userId == request.auth.uid
        && exists(emailPath)
        && !existsAfter(emailPath)
        && invitation.email == request.auth.token.email
        && invitation.active == true
        && invitation.role in [
          'admin', 'manager', 'clerk', 'productionDevelopment', 'productionControl', 'sales'
        ]
        && invitation.authUid is string
        && (invitation.authUid == '' || invitation.authUid == request.auth.uid)
        && request.resource.data.diff(invitation).affectedKeys().hasOnly([
          'authUid', 'googleDisplayName', 'lastLoginAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.googleDisplayName is string
        && request.resource.data.googleDisplayName.size() <= 200
        && request.resource.data.lastLoginAt is int
        && validUserAccess(userId);
    }

    // selfDeletesMigratedEmailAccess（UID 權限建立完成後刪除本人電子信箱核准文件）
    function selfDeletesMigratedEmailAccess(userId) {
      let uidPath = /databases/$(database)/documents/userAccess/$(request.auth.uid);
      let migrated = getAfter(uidPath).data;
      return verifiedGoogleAccount()
        && userId == request.auth.token.email
        && resource.data.email == userId
        && resource.data.active == true
        && resource.data.role in [
          'admin', 'manager', 'clerk', 'productionDevelopment', 'productionControl', 'sales'
        ]
        && resource.data.authUid is string
        && (resource.data.authUid == '' || resource.data.authUid == request.auth.uid)
        && existsAfter(uidPath)
        && migrated.email == userId
        && migrated.authUid == request.auth.uid
        && migrated.diff(resource.data).affectedKeys().hasOnly([
          'authUid', 'googleDisplayName', 'lastLoginAt'
        ]);
    }

    // adminPreservesOwnAccess（管理員不可透過直接請求停用或降低自己的權限）
    function adminPreservesOwnAccess(userId) {
      return request.auth.uid != userId
        || (request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active);
    }

    // validRolePermissions（角色功能權限資料檢查）
    function validRolePermissions(roleId) {
      return roleId in ['manager', 'clerk', 'productionDevelopment', 'productionControl', 'sales']
        && request.resource.data.keys().hasAll([
          'role', 'active', 'features', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'role', 'active', 'features', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.role == roleId
        && request.resource.data.active is bool
        && validFeatureMap(request.resource.data.features)
        && request.resource.data.updatedAt is int
        && validShortString(request.resource.data.updatedBy, 100);
    }

    // validSystemData（舊系統單一字串資料檢查）
    function validSystemData(maximumLength) {
      return request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= maximumLength;
    }

    // validNonNegativeInteger（非負整數檢查）
    function validNonNegativeInteger(value) {
      return value is int && value >= 0;
    }

    // validOperationLogAction（操作紀錄功能與動作配對檢查）
    function validOperationLogAction() {
      let permissionKey = request.resource.data.permissionKey;
      let feature = request.resource.data.feature;
      let action = request.resource.data.action;
      return (permissionKey == 'summary'
          && feature == 'products'
          && action in ['productImport', 'productBackupExport'])
        || (permissionKey == 'export'
          && feature == 'cost'
          && action == 'productCostExport')
        || (permissionKey == 'costlog'
          && feature == 'cost'
          && action == 'costSettingsUpdate')
        || (permissionKey in ['progress', 'orderImport']
          && feature == 'orders'
          && action == 'orderImport')
        || (permissionKey == 'cutting'
          && feature == 'cutting'
          // cuttingTemplateDelete（刪除裁帶模板）與既有裁帶操作使用同一功能權限。
          && action in [
            'cuttingTemplateImport', 'cuttingTemplateDelete',
            'cuttingExcelExport', 'cuttingPdfExport'
          ]);
    }

    // validOperationLog（每次操作一筆且建立後不可變更的操作紀錄）
    function validOperationLog() {
      return request.resource.data.keys().hasAll([
          'permissionKey', 'feature', 'action', 'status', 'createdAt',
          'createdByUid', 'createdBy', 'itemCount', 'detailCount'
        ])
        && request.resource.data.keys().hasOnly([
          'permissionKey', 'feature', 'action', 'status', 'createdAt',
          'createdByUid', 'createdBy', 'itemCount', 'detailCount',
          'overwriteCount', 'skippedCount', 'fileName', 'changes', 'note'
        ])
        && validOperationLogAction()
        && request.resource.data.status in ['success', 'partial', 'failed']
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > 0
        && request.resource.data.createdByUid == request.auth.uid
        && validShortString(request.resource.data.createdBy, 200)
        && validNonNegativeInteger(request.resource.data.itemCount)
        && validNonNegativeInteger(request.resource.data.detailCount)
        && (!('overwriteCount' in request.resource.data)
          || validNonNegativeInteger(request.resource.data.overwriteCount))
        && (!('skippedCount' in request.resource.data)
          || validNonNegativeInteger(request.resource.data.skippedCount))
        && (!('fileName' in request.resource.data)
          || (request.resource.data.fileName is string
            && request.resource.data.fileName.size() <= 300))
        && (!('changes' in request.resource.data)
          || (request.resource.data.changes is list
            && request.resource.data.changes.size() <= 50))
        && (!('note' in request.resource.data)
          || (request.resource.data.note is string
            && request.resource.data.note.size() <= 500));
    }

    // canReadOperationLog（可讀取操作紀錄）：依紀錄所屬功能分頁判斷，不使用只限管理員的預設。
    function canReadOperationLog(permissionKey) {
      return (permissionKey == 'summary' && hasFeature('summary'))
        || (permissionKey == 'export' && hasFeature('export'))
        || (permissionKey == 'costlog' && hasFeature('costlog'))
        || (permissionKey in ['progress', 'orderImport'] && hasFeature('progress'))
        || (permissionKey == 'cutting' && hasFeature('cutting'));
    }

    // canCreateOperationLog（可建立操作紀錄）：只要可以執行該頁動作就可留下紀錄。
    function canCreateOperationLog() {
      let permissionKey = request.resource.data.permissionKey;
      let action = request.resource.data.action;
      return (permissionKey == 'summary' && hasFeature('summary'))
        || (permissionKey == 'export' && hasFeature('export'))
        || (permissionKey == 'costlog'
          && action == 'costSettingsUpdate'
          && hasFeature('settings'))
        || (permissionKey in ['progress', 'orderImport'] && hasFeature('progress'))
        || (permissionKey == 'cutting' && hasFeature('cutting'));
    }

    // validOrder（訂單資料檢查）
    function validOrder() {
      return validShortString(request.resource.data.orderId, 200)
        && request.resource.data.itemCount is int
        && request.resource.data.itemCount >= 0
        && request.resource.data.totalQty is int
        && request.resource.data.totalQty >= 0
        && request.resource.data.importStatus in ['importing', 'ready', 'failed']
        && (!('processCount' in request.resource.data)
          || (request.resource.data.processCount is int
            && request.resource.data.processCount >= 0))
        && (!('productCodes' in request.resource.data)
          || (request.resource.data.productCodes is list
            && request.resource.data.productCodes.size() <= 498))
        && (!('processVersion' in request.resource.data)
          || validShortString(request.resource.data.processVersion, 150));
    }

    // validOrderProcess（訂單工序資料檢查）
    function validOrderProcess() {
      return validShortString(request.resource.data.orderId, 200)
        && validShortString(request.resource.data.orderNo, 200)
        && validShortString(request.resource.data.code, 200)
        && request.resource.data.orderQty is int
        && request.resource.data.orderQty > 0
        && (!('approvedQty' in request.resource.data)
          || (request.resource.data.approvedQty is int
            && request.resource.data.approvedQty >= 0))
        && (!('pendingQty' in request.resource.data)
          || (request.resource.data.pendingQty is int
            && request.resource.data.pendingQty >= 0));
    }

    // hasNoLegacyReportCounters（新訂單工序不得建立舊報工數量欄位）
    function hasNoLegacyReportCounters() {
      return !('approvedQty' in request.resource.data)
        && !('pendingQty' in request.resource.data);
    }

    // preservesLegacyReportCounters（既有舊報工數量欄位只能原樣保留）
    function preservesLegacyReportCounters() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'approvedQty', 'pendingQty'
      ]);
    }

    // validSecondSyncOrderUpdate（工序秒數同步的訂單狀態變更檢查）。
    function validSecondSyncOrderUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly([
          'lifecycleStatus', 'secondSyncJobId', 'secondSyncStartedAt',
          'secondSyncCompletedAt', 'secondSyncBy', 'processVersion'
        ])
        && request.resource.data.lifecycleStatus in ['active', 'syncingSeconds']
        && (!('secondSyncJobId' in request.resource.data)
          || request.resource.data.secondSyncJobId == null
          || validShortString(request.resource.data.secondSyncJobId, 200))
        && (!('secondSyncStartedAt' in request.resource.data)
          || (request.resource.data.secondSyncStartedAt is int
            && request.resource.data.secondSyncStartedAt > 0))
        && (!('secondSyncCompletedAt' in request.resource.data)
          || (request.resource.data.secondSyncCompletedAt is int
            && request.resource.data.secondSyncCompletedAt > 0))
        && (!('secondSyncBy' in request.resource.data)
          || validShortString(request.resource.data.secondSyncBy, 200));
    }

    // validSecondSyncProcessUpdate（工序秒數同步只能改秒數與同步資訊）。
    function validSecondSyncProcessUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly([
          'workStdSec', 'processSec', 'quoteSnapshotSec', 'slPerHour',
          'secondSyncedAt', 'secondSyncedBy'
        ])
        && request.resource.data.workStdSec is number
        && request.resource.data.workStdSec > 0
        && request.resource.data.processSec is number
        && request.resource.data.processSec > 0
        && request.resource.data.quoteSnapshotSec is number
        && request.resource.data.quoteSnapshotSec > 0
        && request.resource.data.slPerHour is int
        && request.resource.data.slPerHour >= 0
        && request.resource.data.secondSyncedAt is int
        && request.resource.data.secondSyncedAt > 0
        && validShortString(request.resource.data.secondSyncedBy, 200);
    }

    // configuredRoleCanUpdateOrder（可設定角色可修改訂單的範圍）。
    function configuredRoleCanUpdateOrder() {
      let roleId = accessDocument().role;
      let rolePath = /databases/$(database)/documents/rolePermissions/$(roleId);
      let features = get(rolePath).data.features;
      return exists(rolePath)
        && get(rolePath).data.active == true
        && get(rolePath).data.role == roleId
        && (features.progress == true
          || (features.sync == true && validSecondSyncOrderUpdate()));
    }

    // canUpdateOrder（可修改訂單）：訂單分頁可完整修改，同步分頁只能改同步狀態。
    function canUpdateOrder() {
      return isAdmin()
        || (isConfigurableRole() && configuredRoleCanUpdateOrder());
    }

    // configuredRoleCanUpdateOrderProcess（可設定角色可修改訂單工序的範圍）。
    function configuredRoleCanUpdateOrderProcess() {
      let roleId = accessDocument().role;
      let rolePath = /databases/$(database)/documents/rolePermissions/$(roleId);
      let features = get(rolePath).data.features;
      return exists(rolePath)
        && get(rolePath).data.active == true
        && get(rolePath).data.role == roleId
        && (features.progress == true
          || (features.sync == true && validSecondSyncProcessUpdate()));
    }

    // canUpdateOrderProcess（可修改訂單工序）。
    function canUpdateOrderProcess() {
      return isAdmin()
        || (isConfigurableRole() && configuredRoleCanUpdateOrderProcess());
    }

    // validProduct（款號工序資料檢查）
    function validProduct() {
      return validShortString(request.resource.data.code, 200)
        && request.resource.data.ops is list
        && request.resource.data.ops.size() <= 200;
    }

    // validProductChange（款號增量變更資料檢查）
    function validProductChange() {
      return request.resource.data.keys().hasAll([
          'sequence', 'fromVersion', 'toVersion', 'changedCodes', 'deletedCodes',
          'createdAt', 'createdByUid', 'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'sequence', 'fromVersion', 'toVersion', 'changedCodes', 'deletedCodes',
          'createdAt', 'createdByUid', 'createdBy'
        ])
        && request.resource.data.sequence is int
        && request.resource.data.sequence > 0
        && validShortString(request.resource.data.fromVersion, 100)
        && validShortString(request.resource.data.toVersion, 100)
        && request.resource.data.fromVersion != request.resource.data.toVersion
        && request.resource.data.changedCodes is list
        && request.resource.data.deletedCodes is list
        && request.resource.data.changedCodes.size()
          + request.resource.data.deletedCodes.size() > 0
        && request.resource.data.changedCodes.size()
          + request.resource.data.deletedCodes.size() <= 498
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > 0
        && request.resource.data.createdByUid == request.auth.uid
        && validShortString(request.resource.data.createdBy, 200);
    }

    // validCuttingChunk（裁帶模板分段資料檢查）
    function validCuttingChunk() {
      return request.resource.data.keys().hasAll(['templateId', 'index', 'data', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['templateId', 'index', 'data', 'updatedAt'])
        && validShortString(request.resource.data.templateId, 300)
        && request.resource.data.index is int
        && request.resource.data.index >= 0
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 650000
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 100;
    }

    // configuredRoleCanReadProducts（可設定角色可以讀取款號工序資料）
    // 同一個請求只取得一次 features（功能權限），避免重複呼叫 hasFeature（功能權限判斷）
    // 造成 Firestore Rules（雲端安全規則）運算式數量超過上限。
    function configuredRoleCanReadProducts() {
      let roleId = accessDocument().role;
      let rolePath = /databases/$(database)/documents/rolePermissions/$(roleId);
      let features = get(rolePath).data.features;
      return exists(rolePath)
        && get(rolePath).data.active == true
        && get(rolePath).data.role == roleId
        && (('cutting' in features && features.cutting == true)
        || ('summary' in features && features.summary == true
          && (!('productsMain' in features) || features.productsMain == true))
        || ('progress' in features && features.progress == true)
        || ('export' in features && features.export == true
          && (('costMain' in features && features.costMain == true)
            || (!('costMain' in features)
              && 'costView' in features && features.costView == true))));
    }

    // canReadProducts（可以讀取款號工序資料）
    function canReadProducts() {
      return isAdmin()
        || (isConfigurableRole() && configuredRoleCanReadProducts());
    }

    // configuredRoleCanReadOrders（可設定角色可以讀取訂單與工序資料）
    function configuredRoleCanReadOrders() {
      let roleId = accessDocument().role;
      let rolePath = /databases/$(database)/documents/rolePermissions/$(roleId);
      let features = get(rolePath).data.features;
      return exists(rolePath)
        && get(rolePath).data.active == true
        && get(rolePath).data.role == roleId
        && (('progress' in features && features.progress == true)
          || ('sync' in features && features.sync == true));
    }

    // canReadOrders（可以讀取訂單與工序資料）
    function canReadOrders() {
      return isAdmin()
        || (isConfigurableRole() && configuredRoleCanReadOrders());
    }

    // configuredRoleCanReadCostSettings（可設定角色可讀取成本設定）：單次取得權限文件，避免重複判斷超過規則上限。
    function configuredRoleCanReadCostSettings() {
      let roleId = accessDocument().role;
      let rolePath = /databases/$(database)/documents/rolePermissions/$(roleId);
      let features = get(rolePath).data.features;
      return exists(rolePath)
        && get(rolePath).data.active == true
        && get(rolePath).data.role == roleId
        && ((features.costView == true
            && features.summary == true
            && (!('productsMain' in features) || features.productsMain == true))
          || ('settings' in features && features.settings == true
            && (!('costMain' in features) || features.costMain == true))
          || (features.export == true
            && (!('costMain' in features) || features.costMain == true)));
    }

    // canReadCostSettings（可讀取成本設定）。
    function canReadCostSettings() {
      return isAdmin()
        || (isConfigurableRole() && configuredRoleCanReadCostSettings());
    }

    // validDataVersions（資料版本文件檢查）
    function validDataVersions() {
      return request.resource.data.keys().hasAll(['updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly([
          'updatedAt', 'updatedBy', 'orders', 'orderProcesses', 'settings',
          'operationSettings', 'costSettings', 'impHist', 'cLog',
          'employees', 'reports', 'attendance', 'employeeUserHistory'
        ])
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt > 0
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // hasNoLegacyDataVersionKeys（新資料版本文件不得建立舊流程版本欄位）
    function hasNoLegacyDataVersionKeys() {
      return !request.resource.data.keys().hasAny([
        'employees', 'reports', 'attendance', 'employeeUserHistory'
      ]);
    }

    // preservesLegacyDataVersionKeys（既有舊流程版本欄位只能原樣保留）
    function preservesLegacyDataVersionKeys() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'employees', 'reports', 'attendance', 'employeeUserHistory'
      ]);
    }

    // canTouchDataVersionKeys（可以更新指定資料版本欄位）
    function canTouchDataVersionKeys(keys) {
      return (!keys.hasAny(['orders', 'orderProcesses'])
          || hasFeature('progress') || hasFeature('sync'))
        && (!keys.hasAny(['operationSettings', 'costSettings']) || hasFeature('settings'))
        && (!keys.hasAny(['settings', 'cLog']) || isAdmin())
        && (!keys.hasAny(['impHist']) || hasFeature('summary'));
    }

    // userAccess（使用者存取權限）
    match /userAccess/{userId} {
      allow get: if isAdmin()
        || (verifiedGoogleAccount()
          && (request.auth.uid == userId || request.auth.token.email == userId));
      allow list: if isAdmin();
      allow create: if (isAdmin() && validUserAccess(userId))
        || selfCreatesUidAccess(userId);
      allow update: if isAdmin() && validUserAccess(userId) && adminPreservesOwnAccess(userId);
      allow delete: if (isAdmin() && request.auth.uid != userId)
        || selfDeletesMigratedEmailAccess(userId);
    }

    // rolePermissions（角色功能權限）
    match /rolePermissions/{roleId} {
      allow read: if isAdmin()
        || (isConfigurableRole() && roleId == accessDocument().role);
      allow create, update: if isAdmin() && validRolePermissions(roleId);
      allow delete: if false;
    }

    // system/accounts（舊系統帳號資料）：完成身分驗證改造後禁止瀏覽器存取。
    match /system/accounts {
      allow read, write: if false;
    }

    // system/permissions（舊字串權限資料）：改由 rolePermissions（角色功能權限）取代。
    match /system/permissions {
      allow read, write: if false;
    }

    // system/dataVersions（各功能資料版本）
    match /system/dataVersions {
      allow read: if isDeskUser();
      allow create: if isDeskUser()
        && validDataVersions()
        && hasNoLegacyDataVersionKeys()
        && canTouchDataVersionKeys(request.resource.data.keys());
      allow update: if isDeskUser()
        && validDataVersions()
        && preservesLegacyDataVersionKeys()
        && canTouchDataVersionKeys(request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if false;
    }

    // system/settings（舊合併設定）：只供管理員讀取舊資料並轉換，禁止再寫入。
    match /system/settings {
      allow read: if isAdmin();
      allow write: if false;
    }

    // system/operationSettings（一般運算設定）：不含薪資、保險、餐費與時薪。
    match /system/operationSettings {
      allow read: if isDeskUser();
      allow write: if hasFeature('settings') && validSystemData(200000);
    }

    // system/costSettings（成本設定）：敏感工價、成本設定或產品工價匯出授權者才可讀取。
    match /system/costSettings {
      allow read: if canReadCostSettings();
      allow write: if hasFeature('settings') && validSystemData(200000);
    }

    // system/productsMeta（款號版本資料）
    match /system/productsMeta {
      allow read: if canReadProducts();
      allow write: if hasFeature('summary') && validSystemData(200000);
    }

    // system/impHist（匯入記錄）
    match /system/impHist {
      allow read: if isAdmin();
      allow write: if false;
    }

    // system/cLog（成本變動記錄）
    match /system/cLog {
      allow read: if isAdmin();
      allow write: if false;
    }

    // operationLogs（獨立操作紀錄）：依功能權限查詢，建立後禁止修改與刪除。
    match /operationLogs/{logId} {
      allow read: if isAdmin() || canReadOperationLog(resource.data.permissionKey);
      allow create: if canCreateOperationLog() && validOperationLog();
      allow update, delete: if false;
    }

    // system/employeeUserHistory（已淘汰的員工帳號使用歷史）
    match /system/employeeUserHistory {
      allow read, write: if false;
    }

    // products（款號工序資料）
    match /products/{productId} {
      allow read: if canReadProducts();
      allow create, update: if hasFeature('summary') && validProduct();
      allow delete: if hasFeature('summary');
    }

    // productChanges（款號增量變更）：供快取只補讀有變動的款號，建立後禁止修改與刪除。
    match /productChanges/{changeId} {
      allow read: if canReadProducts();
      allow create: if hasFeature('summary') && validProductChange();
      allow update, delete: if false;
    }

    // employees（已淘汰的員工資料）
    match /employees/{employeeId} {
      allow read, write: if false;
    }

    // orders（訂單資料）
    match /orders/{orderId} {
      // 舊訂單若仍含 snapshotHr（平均時薪快照），只有可查看工價者能讀取；管理員載入後會自動清除該欄位。
      allow read: if canReadOrders()
        && (!('snapshotHr' in resource.data) || hasFeature('costView'));
      allow create: if hasFeature('progress') && validOrder();
      allow update: if validOrder() && canUpdateOrder();
      allow delete: if hasFeature('progress');
    }

    // orderProcesses（訂單工序資料）
    match /orderProcesses/{processId} {
      allow read: if canReadOrders();
      allow create: if hasFeature('progress')
        && validOrderProcess()
        && hasNoLegacyReportCounters();
      allow update: if validOrderProcess()
        && preservesLegacyReportCounters()
        && canUpdateOrderProcess();
      allow delete: if hasFeature('progress');
    }

    // reports（已淘汰的報工資料）
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // attendance（已淘汰的考勤資料）
    match /attendance/{attendanceId} {
      allow read, write: if false;
    }

    // orderAdjustments（訂單數量調整記錄）
    match /orderAdjustments/{adjustmentId} {
      allow read, create: if hasFeature('progress');
      allow update, delete: if false;
    }

    // orderLocks（訂單匯入鎖定資料）
    match /orderLocks/{lockId} {
      allow read, create, update, delete: if hasFeature('progress');
    }

    // secondSyncLogs（工序秒數同步記錄）
    match /secondSyncLogs/{syncId} {
      allow read, create, update: if hasFeature('sync');
      allow delete: if isAdmin();
    }

    // efficiencyLogs（已淘汰的效率報表記錄）
    match /efficiencyLogs/{logId} {
      allow read, write: if false;
    }

    // cuttingTemplates（裁帶模板清單）
    match /cuttingTemplates/{templateId} {
      allow read, create, update, delete: if hasFeature('cutting');
    }

    // cuttingTemplateChunks（裁帶模板檔案分段）
    match /cuttingTemplateChunks/{chunkId} {
      allow read, delete: if hasFeature('cutting');
      allow create, update: if hasFeature('cutting') && validCuttingChunk();
    }

    // 未列出的資料路徑與未知角色全部拒絕，管理員也不能自動存取未核准路徑。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
