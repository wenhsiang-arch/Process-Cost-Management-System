/*
  Cloud Firestore Security Rules（雲端文件資料庫安全規則）草稿

  重要狀態：
  1. 本檔是版本控制中的規則來源；每次修改後必須先測試，再由管理員部署。
  2. 系統已使用 Firebase Authentication（Firebase 身分驗證）與 Google（Google 帳號）登入。
  3. 保留第一位管理員以 UID（使用者識別碼）建立的 userAccess（使用者存取權限）文件作為安全退路。
  4. 必須建立 manager（課長）與 clerk（文員）的 rolePermissions（角色功能權限）文件。
  5. leader（班長）與 user（員工）暫時不得使用手機端資料功能。

  規則技術字串：
  - rules_version（規則版本）
  - service（服務）
  - match（資料路徑比對）
  - allow（允許條件）
  - read（讀取）、get（讀取單筆）、list（讀取清單）
  - create（新增）、update（修改）、delete（刪除）、write（寫入）
  - request.auth（可信任登入身分）
  - request.resource（寫入後資料）
  - resource（寫入前資料）
  - database（資料庫識別）
*/

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // signedIn（已登入判斷）
    function signedIn() {
      return request.auth != null;
    }

    // verifiedGoogleAccount（已驗證 Google 帳號判斷）
    function verifiedGoogleAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.size() > 3
        && request.auth.token.email.size() <= 254;
    }

    // hasUidAccessDocument（具有舊 UID 使用者權限文件）
    function hasUidAccessDocument() {
      return verifiedGoogleAccount()
        && exists(/databases/$(database)/documents/userAccess/$(request.auth.uid));
    }

    // hasEmailAccessDocument（具有預先核准電子信箱權限文件）
    function hasEmailAccessDocument() {
      return verifiedGoogleAccount()
        && exists(/databases/$(database)/documents/userAccess/$(request.auth.token.email));
    }

    // hasAccessDocument（具有使用者權限文件）
    function hasAccessDocument() {
      return hasUidAccessDocument() || hasEmailAccessDocument();
    }

    // accessDocument（目前使用者權限文件）
    function accessDocument() {
      return hasUidAccessDocument()
        ? get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data
        : get(/databases/$(database)/documents/userAccess/$(request.auth.token.email)).data;
    }

    // activeAccount（帳號已啟用）
    function activeAccount() {
      return hasAccessDocument() && accessDocument().active == true;
    }

    // admin（管理員）、manager（課長）、clerk（文員）、leader（班長）、user（員工）
    // isAdmin（管理員判斷）
    function isAdmin() {
      return activeAccount() && accessDocument().role == 'admin';
    }

    // isManager（課長判斷）
    function isManager() {
      return activeAccount() && accessDocument().role == 'manager';
    }

    // isClerk（文員判斷）
    function isClerk() {
      return activeAccount() && accessDocument().role == 'clerk';
    }

    // isDeskUser（允許使用桌機系統的角色判斷）
    function isDeskUser() {
      return isAdmin() || isManager() || isClerk();
    }

    // managerPermissionsReady（課長權限資料可用）
    function managerPermissionsReady() {
      return exists(/databases/$(database)/documents/rolePermissions/manager)
        && get(/databases/$(database)/documents/rolePermissions/manager).data.active == true;
    }

    // clerkPermissionsReady（文員權限資料可用）
    function clerkPermissionsReady() {
      return exists(/databases/$(database)/documents/rolePermissions/clerk)
        && get(/databases/$(database)/documents/rolePermissions/clerk).data.active == true;
    }

    // hasFeature（具有功能權限）
    function hasFeature(feature) {
      return isAdmin()
        || (isManager()
          && managerPermissionsReady()
          && get(/databases/$(database)/documents/rolePermissions/manager).data.features[feature] == true)
        || (isClerk()
          && clerkPermissionsReady()
          && get(/databases/$(database)/documents/rolePermissions/clerk).data.features[feature] == true);
    }

    // validShortString（短文字安全檢查）
    function validShortString(value, maximumLength) {
      return value is string && value.size() > 0 && value.size() <= maximumLength;
    }

    // validNonNegativeNumber（非負數安全檢查）
    function validNonNegativeNumber(value) {
      return (value is int || value is float) && value >= 0;
    }

    // 功能識別：attendance（考勤）、stats（統計）、employees（員工管理）
    // progress（訂單進度）、approval（報工審批）、replog（報工記錄）
    // accounts（帳號管理）、export（匯出）、costlog（成本記錄）
    // summary（款號總表）、orderImport（訂單匯入）、cutting（裁帶統計）
    // efficiency（效率報表）、sync（工序秒數同步）
    // validFeatureMap（功能權限欄位檢查）
    function validFeatureMap(features) {
      return features is map
        && features.keys().hasAll([
          'attendance', 'stats', 'employees', 'progress', 'approval', 'replog',
          'accounts', 'export', 'costlog', 'summary', 'orderImport', 'cutting',
          'efficiency', 'sync'
        ])
        && features.keys().hasOnly([
          'attendance', 'stats', 'employees', 'progress', 'approval', 'replog',
          'accounts', 'export', 'costlog', 'summary', 'orderImport', 'cutting',
          'efficiency', 'sync'
        ])
        && features.attendance is bool
        && features.stats is bool
        && features.employees is bool
        && features.progress is bool
        && features.approval is bool
        && features.replog is bool
        && features.accounts is bool
        && features.export is bool
        && features.costlog is bool
        && features.summary is bool
        && features.orderImport is bool
        && features.cutting is bool
        && features.efficiency is bool
        && features.sync is bool;
    }

    // validUserAccess（使用者存取權限資料檢查）
    function validUserAccess(userId) {
      return request.resource.data.keys().hasAll([
          'username', 'role', 'active', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'username', 'displayName', 'department', 'role', 'active', 'updatedAt', 'updatedBy',
          'email', 'authUid', 'googleDisplayName', 'createdAt', 'lastLoginAt'
        ])
        && validShortString(request.resource.data.username, 100)
        && request.resource.data.role in ['admin', 'manager', 'clerk', 'leader', 'user']
        && request.resource.data.active is bool
        && request.resource.data.updatedAt is int
        && validShortString(request.resource.data.updatedBy, 100)
        && (!('displayName' in request.resource.data)
          || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() <= 200))
        && (!('department' in request.resource.data)
          || (request.resource.data.department is string
            && request.resource.data.department.size() <= 100))
        && (
          !('email' in request.resource.data)
          || (
            request.resource.data.keys().hasAll([
              'email', 'authUid', 'googleDisplayName', 'createdAt'
            ])
            && request.resource.data.email == userId
            && validShortString(request.resource.data.email, 254)
            && request.resource.data.email.matches('^[^/]+@[^/]+$')
            && request.resource.data.authUid is string
            && request.resource.data.authUid.size() <= 128
            && request.resource.data.authUid.matches('^[^/]*$')
            && request.resource.data.googleDisplayName is string
            && request.resource.data.googleDisplayName.size() <= 200
            && request.resource.data.createdAt is int
            && (!('lastLoginAt' in request.resource.data)
              || request.resource.data.lastLoginAt is int)
          )
        );
    }

    // selfEmailBinding（本人首次登入時只能綁定 UID 與 Google 顯示資料）
    function selfEmailBinding(userId) {
      return verifiedGoogleAccount()
        && request.auth.token.email == userId
        && resource.data.email == userId
        && resource.data.active == true
        && resource.data.role in ['admin', 'manager', 'clerk']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authUid', 'googleDisplayName', 'lastLoginAt'
        ])
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.googleDisplayName is string
        && request.resource.data.googleDisplayName.size() <= 200
        && request.resource.data.lastLoginAt is int
        && validUserAccess(userId);
    }

    // adminPreservesOwnAccess（管理員不可透過直接請求停用或降低自己的權限）
    function adminPreservesOwnAccess(userId) {
      return (request.auth.uid != userId && request.auth.token.email != userId)
        || (request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active);
    }

    // validRolePermissions（角色功能權限資料檢查）
    function validRolePermissions(roleId) {
      return roleId in ['manager', 'clerk']
        && request.resource.data.keys().hasAll([
          'role', 'active', 'features', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'role', 'active', 'features', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.role == roleId
        && request.resource.data.active is bool
        && validFeatureMap(request.resource.data.features)
        && request.resource.data.updatedAt is int
        && validShortString(request.resource.data.updatedBy, 100);
    }

    // validSystemData（舊系統單一字串資料檢查）
    function validSystemData(maximumLength) {
      return request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= maximumLength;
    }

    // validEmployee（員工資料檢查；正式規則不允許保存密碼）
    function validEmployee() {
      return request.resource.data.keys().hasAll(['name', 'user', 'dept', 'role', 'updatedAt'])
        && request.resource.data.keys().hasOnly([
          'name', 'user', 'dept', 'role', 'createdAt', 'updatedAt'
        ])
        && validShortString(request.resource.data.name, 200)
        && validShortString(request.resource.data.user, 100)
        && request.resource.data.dept is string
        && request.resource.data.dept.size() <= 100
        && request.resource.data.role in ['leader', 'user']
        && request.resource.data.updatedAt is int;
    }

    // validAttendance（考勤資料檢查）
    function validAttendance() {
      return request.resource.data.keys().hasAll([
          'empId', 'empName', 'empDept', 'user', 'regularHours', 'overtimeHours',
          'totalHours', 'date'
        ])
        && validShortString(request.resource.data.empId, 200)
        && request.resource.data.empName is string
        && request.resource.data.empName.size() <= 200
        && validShortString(request.resource.data.date, 20)
        && validNonNegativeNumber(request.resource.data.regularHours)
        && validNonNegativeNumber(request.resource.data.overtimeHours)
        && validNonNegativeNumber(request.resource.data.totalHours)
        && request.resource.data.regularHours <= 24
        && request.resource.data.overtimeHours <= 24
        && request.resource.data.totalHours <= 24
        && request.resource.data.totalHours
          == request.resource.data.regularHours + request.resource.data.overtimeHours;
    }

    // validOrder（訂單資料檢查）
    function validOrder() {
      return validShortString(request.resource.data.orderId, 200)
        && request.resource.data.itemCount is int
        && request.resource.data.itemCount >= 0
        && request.resource.data.totalQty is int
        && request.resource.data.totalQty >= 0
        && request.resource.data.importStatus in ['importing', 'ready', 'failed'];
    }

    // validOrderProcess（訂單工序資料檢查）
    function validOrderProcess() {
      return validShortString(request.resource.data.orderId, 200)
        && validShortString(request.resource.data.orderNo, 200)
        && validShortString(request.resource.data.code, 200)
        && request.resource.data.orderQty is int
        && request.resource.data.orderQty > 0
        && request.resource.data.approvedQty is int
        && request.resource.data.approvedQty >= 0
        && request.resource.data.pendingQty is int
        && request.resource.data.pendingQty >= 0
        && request.resource.data.approvedQty + request.resource.data.pendingQty
          <= request.resource.data.orderQty;
    }

    // validReport（報工資料檢查）
    function validReport() {
      return validShortString(request.resource.data.empId, 200)
        && validShortString(request.resource.data.orderId, 200)
        && validShortString(request.resource.data.processId, 200)
        && request.resource.data.qty is int
        && request.resource.data.qty > 0
        && request.resource.data.status in ['pending', 'approved', 'rejected', 'voided'];
    }

    // validProduct（款號工序資料檢查）
    function validProduct() {
      return validShortString(request.resource.data.code, 200)
        && request.resource.data.ops is list
        && request.resource.data.ops.size() <= 200;
    }

    // validCuttingChunk（裁帶模板分段資料檢查）
    function validCuttingChunk() {
      return request.resource.data.keys().hasAll(['templateId', 'index', 'data', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['templateId', 'index', 'data', 'updatedAt'])
        && validShortString(request.resource.data.templateId, 300)
        && request.resource.data.index is int
        && request.resource.data.index >= 0
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 650000
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 100;
    }

    // canReadProducts（可以讀取款號工序資料）
    function canReadProducts() {
      return hasFeature('summary') || hasFeature('export')
        || hasFeature('orderImport') || hasFeature('cutting');
    }

    // canReadEmployees（可以讀取員工資料）
    function canReadEmployees() {
      return hasFeature('employees') || hasFeature('attendance') || hasFeature('stats')
        || hasFeature('approval') || hasFeature('replog') || hasFeature('efficiency');
    }

    // canReadOrders（可以讀取訂單與工序資料）
    function canReadOrders() {
      return hasFeature('progress') || hasFeature('orderImport') || hasFeature('approval')
        || hasFeature('replog') || hasFeature('sync') || hasFeature('efficiency');
    }

    // canReadReports（可以讀取報工資料）
    function canReadReports() {
      return hasFeature('approval') || hasFeature('replog')
        || hasFeature('stats') || hasFeature('efficiency');
    }

    // userAccess（使用者存取權限）
    match /userAccess/{userId} {
      allow get: if isAdmin()
        || (verifiedGoogleAccount()
          && (request.auth.uid == userId || request.auth.token.email == userId));
      allow list: if isAdmin();
      allow create: if isAdmin() && validUserAccess(userId);
      allow update: if (isAdmin() && validUserAccess(userId) && adminPreservesOwnAccess(userId))
        || selfEmailBinding(userId);
      allow delete: if isAdmin()
        && request.auth.uid != userId
        && request.auth.token.email != userId;
    }

    // rolePermissions（角色功能權限）
    match /rolePermissions/{roleId} {
      allow read: if isDeskUser();
      allow create, update: if isAdmin() && validRolePermissions(roleId);
      allow delete: if false;
    }

    // system/accounts（舊系統帳號資料）：完成身分驗證改造後禁止瀏覽器存取。
    match /system/accounts {
      allow read, write: if false;
    }

    // system/permissions（舊字串權限資料）：改由 rolePermissions（角色功能權限）取代。
    match /system/permissions {
      allow read, write: if false;
    }

    // system/settings（系統設定）
    match /system/settings {
      allow read: if isDeskUser();
      allow write: if isAdmin() && validSystemData(200000);
    }

    // system/productsMeta（款號版本資料）
    match /system/productsMeta {
      allow read: if canReadProducts();
      allow write: if hasFeature('summary') && validSystemData(200000);
    }

    // system/impHist（匯入記錄）
    match /system/impHist {
      allow read: if hasFeature('summary') || hasFeature('export');
      allow write: if hasFeature('summary') && validSystemData(900000);
    }

    // system/cLog（成本變動記錄）
    match /system/cLog {
      allow read: if hasFeature('costlog');
      allow write: if isAdmin() && validSystemData(900000);
    }

    // system/employeeUserHistory（員工帳號使用歷史）
    match /system/employeeUserHistory {
      allow read: if hasFeature('employees');
      allow write: if hasFeature('employees') && validSystemData(900000);
    }

    // products（款號工序資料）
    match /products/{productId} {
      allow read: if canReadProducts();
      allow create, update: if hasFeature('summary') && validProduct();
      allow delete: if hasFeature('summary');
    }

    // employees（員工資料）
    match /employees/{employeeId} {
      allow read: if canReadEmployees();
      allow create, update: if hasFeature('employees') && validEmployee();
      allow delete: if hasFeature('employees');
    }

    // orders（訂單資料）
    match /orders/{orderId} {
      allow read: if canReadOrders();
      allow create: if hasFeature('orderImport') && validOrder();
      allow update: if (hasFeature('orderImport') || hasFeature('progress')
        || hasFeature('approval') || hasFeature('sync')) && validOrder();
      allow delete: if isAdmin()
        || (hasFeature('orderImport') && resource.data.importStatus == 'failed');
    }

    // orderProcesses（訂單工序資料）
    match /orderProcesses/{processId} {
      allow read: if canReadOrders();
      allow create: if hasFeature('orderImport') && validOrderProcess();
      allow update: if (hasFeature('orderImport') || hasFeature('approval')
        || hasFeature('replog') || hasFeature('sync')) && validOrderProcess();
      allow delete: if isAdmin() || hasFeature('orderImport');
    }

    // reports（報工資料）：手機端角色目前不會通過 hasFeature（功能權限）判斷。
    match /reports/{reportId} {
      allow read: if canReadReports();
      allow create, update: if hasFeature('approval') && validReport();
      allow delete: if isAdmin();
    }

    // attendance（考勤資料）
    match /attendance/{attendanceId} {
      allow read: if hasFeature('attendance') || hasFeature('stats') || hasFeature('efficiency');
      allow create, update: if hasFeature('attendance') && validAttendance();
      allow delete: if hasFeature('attendance');
    }

    // orderAdjustments（訂單數量調整記錄）
    match /orderAdjustments/{adjustmentId} {
      allow read: if hasFeature('orderImport') || hasFeature('progress');
      allow create: if hasFeature('orderImport');
      allow update, delete: if isAdmin();
    }

    // orderLocks（訂單匯入鎖定資料）
    match /orderLocks/{lockId} {
      allow read, create, update, delete: if hasFeature('orderImport');
    }

    // secondSyncLogs（工序秒數同步記錄）
    match /secondSyncLogs/{syncId} {
      allow read, create, update: if hasFeature('sync');
      allow delete: if isAdmin();
    }

    // efficiencyLogs（效率報表記錄）
    match /efficiencyLogs/{logId} {
      allow read, create, delete: if hasFeature('efficiency');
      allow update: if false;
    }

    // cuttingTemplates（裁帶模板清單）
    match /cuttingTemplates/{templateId} {
      allow read, create, update, delete: if hasFeature('cutting');
    }

    // cuttingTemplateChunks（裁帶模板檔案分段）
    match /cuttingTemplateChunks/{chunkId} {
      allow read, delete: if hasFeature('cutting');
      allow create, update: if hasFeature('cutting') && validCuttingChunk();
    }

    // 未列出的資料路徑與未知角色全部拒絕，管理員也不能自動存取未核准路徑。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
